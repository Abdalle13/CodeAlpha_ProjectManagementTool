NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/taskora
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
AUTH_COOKIE_NAME=taskora_token
SYSTEM_ADMIN_EMAIL=your-admin-email@example.com
SYSTEM_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-random-token
